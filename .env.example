# Add these values in Vercel Project Settings > Environment Variables.
# Never commit a real API key.
RESEND_API_KEY=re_replace_with_your_key
CONTACT_TO_EMAIL=your-test-email@example.com
CONTACT_FROM_EMAIL=Schottenstein Homes Website <onboarding@resend.dev>

# Required for durable contact-form rate limiting. Vercel's Upstash integration
# may provide either the UPSTASH_* pair or the KV_* pair. Use only one pair,
# plus a randomly generated server-only secret of at least 32 bytes.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_your_server_only_token
# KV_REST_API_URL=https://your-database.upstash.io
# KV_REST_API_TOKEN=replace_with_your_server_only_token
RATE_LIMIT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
